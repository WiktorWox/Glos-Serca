{
  "Format": "2.0.0",
  "VoicePacks": [
    {
      "Format": "2.0.0",
      "VoicePackId": "GlosSerca.Sandy.pl",
      "VoicePackName": "Głos Serca (Sandy)",
      "Character": "Sandy",
      "Language": "pl",
      "Entries": [
        {
          "DialogueFrom": "accept_866",
          "DialogueText": "Róża z Doliny? To takie cudowne! Dziękuję! {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/1.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:accept_866",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "accept_866",
          "DialogueText": "Gdy zatęsknię za doliną, powącham tę różę. He he. {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/2.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:accept_866",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "accept_866",
          "DialogueText": "Proszę, weź to. Leżało na półce przez 10 lat i nikt tego nie kupił. Możesz to sobie zatrzymać!",
          "AudioPath": "assets/pl/Sandy/3.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:accept_866",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "AcceptGift_(O)18",
          "DialogueText": "O, wow! Nic tak nie mówi 'wiosna' jak żonkil z Doliny! {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/4.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:AcceptGift_(O)18",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_(O)StardropTea",
          "DialogueText": "Wow, to takie rzadkie... Nie mogę uwierzyć, że mi to dajesz! Dzięki, skarbie!",
          "AudioPath": "assets/pl/Sandy/5.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:AcceptGift_(O)StardropTea",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_(O)418",
          "DialogueText": "Ach... nawet zimą Dolina Stardew ma piękne kwiaty.",
          "AudioPath": "assets/pl/Sandy/6.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:AcceptGift_(O)418",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain",
          "DialogueText": "Słyszałam, że u was występuje jakieś rzadkie zjawisko pogodowe.",
          "AudioPath": "assets/pl/Sandy/7.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:GreenRain",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain",
          "DialogueText": "Chciałabym, żeby tutaj też kiedyś spadł deszcz... {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/8.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:GreenRain",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "married_Emily",
          "DialogueText": "Jak minął ten wielki dzień? Emily była tu ostatnio i opowiedziała mi wszystko o waszych planach.",
          "AudioPath": "assets/pl/Sandy/9.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:married_Emily",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "married_Emily",
          "DialogueText": "Będę musiała was kiedyś odwiedzić!",
          "AudioPath": "assets/pl/Sandy/10.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:married_Emily",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "AcceptGift_(O)402",
          "DialogueText": "*niuch*... Mmm... groszek zawsze ma świetny zapach.",
          "AudioPath": "assets/pl/Sandy/11.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:AcceptGift_(O)402",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Hej hej, cukiereczku!",
          "AudioPath": "assets/pl/Sandy/12.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Mon",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Cieszę się, że autobus znowu działa. Zaczynało się tu robić pusto.",
          "AudioPath": "assets/pl/Sandy/13.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Mon",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "... Prawie zbankrutowałam. {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/14.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Mon",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Ale teraz ty tu jesteś, żeby kupić te wszystkie nasiona... prawda, cukiereczku? {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/15.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Mon",
          "PageIndex": 3
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Na zewnątrz możesz znaleźć kokosy i owoce kaktusa. Bierz, ile chcesz.",
          "AudioPath": "assets/pl/Sandy/16.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Tue",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Są cuuudowneee. Heeee!~ {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/17.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Tue",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Witam! Jeśli spotkasz moją przyjaciółkę Emily, pozdrów ją ode mnie, dobrze?",
          "AudioPath": "assets/pl/Sandy/18.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Dzięki! {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/19.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Ten podejrzany gość z tyłu? Nie powinnam o nim rozmawiać.",
          "AudioPath": "assets/pl/Sandy/20.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Tak czy inaczej... jaka jest teraz u was pogoda?",
          "AudioPath": "assets/pl/Sandy/21.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Tutaj niczego sobie nie posadzisz, słonko.",
          "AudioPath": "assets/pl/Sandy/22.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Fri",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Cóż, chyba że jesteś rolnikiem specjalizującym się w kaktusach. {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/23.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Fri",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Cześć! Witaj w Oazie Sandy. Pierwszym przystanku na Pustyni Calico!",
          "AudioPath": "assets/pl/Sandy/24.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sat",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "*szept* Zabrzmiałam profesjonalnie? {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/25.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sat",
          "PageIndex": 1,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Sprawdź nasze nasiona.",
          "AudioPath": "assets/pl/Sandy/26.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sat",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Masz, napij się trochę zimnego mleka dla ochłody. [184]",
          "AudioPath": "assets/pl/Sandy/27.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sat",
          "PageIndex": 3,
          "ActorNote": "[…] – numery przedmiotów, które postać daje graczowi; nie czytać."
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Smaczne, prawda? {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/28.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sat",
          "PageIndex": 4
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Zawsze jest tu ciepło, nawet zimą!",
          "AudioPath": "assets/pl/Sandy/29.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sun",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Tak właściwie, to dla mnie trochę za gorąco... moja delikatna skóra szybko się opala na tym słońcu. {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/30.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sun",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu2",
          "DialogueText": "Ten podejrzany gość z tyłu? Nie powinnam o nim rozmawiać.",
          "AudioPath": "assets/pl/Sandy/31.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu2",
          "DialogueText": "Tak czy inaczej... jaka jest teraz u was pogoda?",
          "AudioPath": "assets/pl/Sandy/32.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu2",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu4",
          "DialogueText": "Hej... Myślę, że mogę ci zaufać. Umiesz dotrzymać tajemnicy, tak?",
          "AudioPath": "assets/pl/Sandy/33.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu4",
          "DialogueText": "*szept* Ten gość z tyłu... to jakiś ekskluzywny klub. Sama nigdy nie byłam w środku, ale dużo mi płacą za wynajem, więc nie pytam.",
          "AudioPath": "assets/pl/Sandy/34.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu4",
          "PageIndex": 1,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Thu4",
          "DialogueText": "WIĘĘĘęc! Jaka jest teraz u was pogoda?",
          "AudioPath": "assets/pl/Sandy/35.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Thu4",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Fri4",
          "DialogueText": "Tak naprawdę nie nazywam się Sandy. To tylko chwytliwa nazwa.",
          "AudioPath": "assets/pl/Sandy/36.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Fri4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri4",
          "DialogueText": "Ale i tak wszyscy tak do mnie mówią, więc już się przyzwyczaiłam.",
          "AudioPath": "assets/pl/Sandy/37.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Fri4",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed8",
          "DialogueText": "Czy to nie jest trochę kosztowne, że tak często tu przyjeżdżasz?",
          "AudioPath": "assets/pl/Sandy/38.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed8",
          "DialogueText": "Pewnie bardzo mnie lubisz, co? Hmmm... {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/39.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sun8",
          "DialogueText": "Witaj, słonko. To tylko ja, samotna w tym wielkim, starym sklepie. Hmmm...",
          "AudioPath": "assets/pl/Sandy/40.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sun8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sun8",
          "DialogueText": "Cóż, oprócz tego dziwnego gościa z tyłu. Ale nigdy nawet nie mrugnie, więc zazwyczaj o nim zapominam.",
          "AudioPath": "assets/pl/Sandy/41.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Sun8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed10",
          "DialogueText": "Hej, to ty, {Farmer_Name}! Cieszę się, że cię widzę. Myślałam, że już nigdy tu nie przyjdziesz!",
          "AudioPath": "assets/pl/Sandy/42.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed10",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Wed10",
          "DialogueText": "Gdybym nie miała tego sklepu, pewnie wróciłabym z tobą na dzień lub dwa... tylko ty, ja i stara farma. {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/43.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed10",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed10",
          "DialogueText": "Musisz mnie częściej odwiedzać, żebym nie zwariowała. {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/44.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Wed10",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Tue10",
          "DialogueText": "Cześć!~ Zostań tu tyle, ile chcesz.",
          "AudioPath": "assets/pl/Sandy/45.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Tue10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue10",
          "DialogueText": "Powietrze jest tu całkiem przyjemne, prawda?",
          "AudioPath": "assets/pl/Sandy/46.ogg",
          "TranslationKey": "Characters/Dialogue/Sandy:Tue10",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "rainy",
          "DialogueText": "Słyszałam, że u was pada. Czy to dlatego tu jesteś? {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/47.ogg",
          "TranslationKey": "Characters/Dialogue/rainy:Sandy",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "rainy",
          "DialogueText": "W sumie trochę tęsknię za deszczem... {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/48.ogg",
          "TranslationKey": "Characters/Dialogue/rainy:Sandy",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s0",
          "DialogueText": "... Klient?",
          "AudioPath": "assets/pl/Sandy/49.ogg",
          "TranslationKey": "Events/SandyHouse:67:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s1",
          "DialogueText": "Cześć! Witam w 'Oazie Sandy'!",
          "AudioPath": "assets/pl/Sandy/50.ogg",
          "TranslationKey": "Events/SandyHouse:67:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s2",
          "DialogueText": "Hej, wyglądasz jak ten nowy farmer, o którym pisała Emily!",
          "AudioPath": "assets/pl/Sandy/51.ogg",
          "TranslationKey": "Events/SandyHouse:67:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s3",
          "DialogueText": "Czyli... autobus do Doliny Stardew znowu działa! {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/52.ogg",
          "TranslationKey": "Events/SandyHouse:67:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s4",
          "DialogueText": "Och, tak bardzo mnie to cieszy! {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/53.ogg",
          "TranslationKey": "Events/SandyHouse:67:s4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SandyHouse/67:s5",
          "DialogueText": "Odwiedź mnie jeszcze kiedyś, nudno mi tu samej.",
          "AudioPath": "assets/pl/Sandy/54.ogg",
          "TranslationKey": "Events/SandyHouse:67:s5",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Sandy",
          "DialogueText": "Słyszałam, że u was pada. Dlatego tu jesteś? {Portrait:Happy}",
          "AudioPath": "assets/pl/Sandy/55.ogg",
          "TranslationKey": "Data/Festivals/fall16:Sandy",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Sandy",
          "DialogueText": "W sumie tęsknię za deszczem... {Portrait:Sad}",
          "AudioPath": "assets/pl/Sandy/56.ogg",
          "TranslationKey": "Data/Festivals/fall16:Sandy",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Festival/fall16/Sandy_y2",
          "DialogueText": "Społeczność Doliny Stardew jest naprawdę jedyna w swoim rodzaju... {Portrait:Neutral}",
          "AudioPath": "assets/pl/Sandy/57.ogg",
          "TranslationKey": "Data/Festivals/fall16:Sandy_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall27/Sandy",
