          "TranslationKey": "Strings/MovieReactions:Sandy_love_AfterMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:DesertFestival_Sandy",
          "DialogueText": "To dla mnie najbardziej pracowity czas w roku! Miło jest móc wszystkich zobaczyć.",
