          "TranslationKey": "Strings/1_6_Strings:MakeOver_Sandy_6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:MakeOver_Sandy_6",
          "DialogueText": "Mam nadzieję, że podoba Ci się Twój nowy wygląd, tak jak i mi! {Portrait:Happy}",
