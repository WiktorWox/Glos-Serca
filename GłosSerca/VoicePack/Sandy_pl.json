          "TranslationKey": "Strings/1_6_Strings:MakeOver_Sandy_AlreadyStyled",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:MakeOver_Sandy_InventoryFull",
