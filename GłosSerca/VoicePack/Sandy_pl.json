          "AudioPath": "assets/pl/Sandy/96.ogg",
          "TranslationKey": "Strings/1_6_Strings:MakeOver_Sandy_5",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:MakeOver_Sandy_6",
          "DialogueText": "Fajnie było! {Portrait:Happy}",
