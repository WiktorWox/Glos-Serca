{
  "Format": "2.0.0",
  "VoicePacks": [
    {
      "Format": "2.0.0",
      "VoicePackId": "GlosSerca.Vincent.pl",
      "VoicePackName": "Głos Serca (Vincent)",
      "Character": "Vincent",
      "Language": "pl",
      "Entries": [
        {
          "DialogueFrom": "Introduction",
          "DialogueText": "Och, nieznajomy! Jestem Vincent.",
          "AudioPath": "assets/pl/Vincent/1.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Introduction",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Introduction",
          "DialogueText": "Mama mówi, żeby nie rozmawiać z obcymi... Ale ty wydajesz się w porządku.",
          "AudioPath": "assets/pl/Vincent/2.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Introduction",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "AcceptBirthdayGift_Positive",
          "DialogueText": "To prezent urodzinowy? Mogę go już otworzyć?",
          "AudioPath": "assets/pl/Vincent/3.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptBirthdayGift_Positive",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptBirthdayGift_Positive",
          "DialogueText": "Ooo, wow! Właśnie tego chciałem! Jupi! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/4.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptBirthdayGift_Positive",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "AcceptBirthdayGift_Negative",
          "DialogueText": "Prezent urodzinowy? Och... to niezbyt fajne. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/5.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptBirthdayGift_Negative",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_(O)StardropTea",
          "DialogueText": "Wow! Ale słodka! Mmmm...",
          "AudioPath": "assets/pl/Vincent/6.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptGift_(O)StardropTea",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_(TR)FrogEgg",
          "DialogueText": "*Gniot* *gniot*... Fuuuj! Mogę to zatrzymać? Mogę, mogę, mogę? Jeeej! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/7.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptGift_(TR)FrogEgg",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "GreenRain",
          "DialogueText": "Mamo! Chcę iść się pobawić na polu!%noturn",
          "AudioPath": "assets/pl/Vincent/8.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:GreenRain",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain_2",
          "DialogueText": "Vincent cały pokryty jest mchem.",
          "AudioPath": "assets/pl/Vincent/9.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:GreenRain_2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_Negative_alcohol_item",
          "DialogueText": "*Niuch*... Co to? Ale śmierdzi... Mamooo!!! {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/10.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:AcceptGift_Negative_alcohol_item",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Resort_Entering",
          "DialogueText": "Ale tu fajnie! Kiedyś zostanę kapitanem statku!",
          "AudioPath": "assets/pl/Vincent/11.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Resort_Entering",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort_Leaving",
          "DialogueText": "Chcę tu niedługo wrócić!",
          "AudioPath": "assets/pl/Vincent/12.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Resort_Leaving",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort_Shore",
          "DialogueText": "Chcę zobaczyć rekina! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/13.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Resort_Shore",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "married_Sam",
          "DialogueText": "Nie zabieraj mi braciszka! {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/14.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:married_Sam",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort",
          "DialogueText": "Jeśli dobrze się przyjrzysz, zobaczysz małe robaczki wyskakujące z piasku. {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/15.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Resort",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "reject_869",
          "DialogueText": "Oooch! Fajne!",
          "AudioPath": "assets/pl/Vincent/16.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:reject_869",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "reject_869",
          "DialogueText": "Ale mama nie pozwoli mi go zatrzymać... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/17.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:reject_869",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Gdy dorosnę, chcę być taki jak mój brat! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/18.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Mon",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Okej! Pa!",
          "AudioPath": "assets/pl/Vincent/19.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Mon",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Mon4",
          "DialogueText": "Cieszę się, że tata wrócił... ale jest inny, niż go zapamiętałem... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/20.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Mon4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Mon4",
          "DialogueText": "Taty długo nie ma... Chciałbym się z nim pobawić. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/21.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Mon4",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "*Ech*... Mama nie pozwala mi zjeść więcej żelków. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/22.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Tue",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Tue6",
          "DialogueText": "Umiesz zachować tajemnicę? {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/23.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Tue6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue6",
          "DialogueText": "Chciałbym poślubić Pannę Penny, jak dorosnę.",
          "AudioPath": "assets/pl/Vincent/24.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Tue6",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue6",
          "DialogueText": "Ale nie mów jej, dobra? {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/25.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Tue6",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Chciałbym poszukać robaków, ale mama się denerwuje, kiedy wracam do domu brudny. {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/26.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Wed",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "To trudny wybór.",
          "AudioPath": "assets/pl/Vincent/27.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Wed",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Jestem głodny... Gdzie jest mama? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/28.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Thu",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu2",
          "DialogueText": "Większość dorosłych to nudziarze. Ale nie ty!",
          "AudioPath": "assets/pl/Vincent/29.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Thu2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Fuj, dziś na kolację gotowane buraki... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/30.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Fri",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "$e",
          "AudioPath": "assets/pl/Vincent/31.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Fri",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "O nie... Mama znowu robi zupę z soczewicy. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/32.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Fri",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Sat_1",
          "DialogueText": "Tata niedługo wróci!",
          "AudioPath": "assets/pl/Vincent/33.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat_1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat_1",
          "DialogueText": "Mam nadzieję, że przywiezie mi jakieś zabawki. {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/34.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat_1",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Panna Penny każe mi co tydzień czytać książkę. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/35.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Przynajmniej czasami pozwala mi je wybierać!",
          "AudioPath": "assets/pl/Vincent/36.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat8",
          "DialogueText": "Tata dziwnie się zachowuje, odkąd wrócił. Co się z nim dzieje? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/37.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat8",
          "DialogueText": "Już się ze mną nie bawi. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/38.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat8",
          "DialogueText": "Zastanawiam się, czy tata kiedyś wróci do domu... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/39.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sat8",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Dzień dobry, proszę pana!",
          "AudioPath": "assets/pl/Vincent/40_male.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sun",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Dzień dobry, proszę pani!",
          "AudioPath": "assets/pl/Vincent/41_female.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sun",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Sun10",
          "DialogueText": "Cześć, wujku {Farmer_Name}!",
          "AudioPath": "assets/pl/Vincent/42_male.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sun10",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Sun10",
          "DialogueText": "Cześć, ciociu {Farmer_Name}!",
          "AudioPath": "assets/pl/Vincent/43_female.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sun10",
          "PageIndex": 1,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Sun10",
          "DialogueText": "Nie mów mojej mamie... Ale jesteś moim ulubionym dorosłym. {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/44.ogg",
          "TranslationKey": "Characters/Dialogue/Vincent:Sun10",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Event/FarmHouse/3918603:s0",
          "DialogueText": "Nie mogę się doczekać, Sam!",
          "AudioPath": "assets/pl/Vincent/45.ogg",
          "TranslationKey": "Events/FarmHouse:3918603:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/FarmHouse/3918603:s1",
          "DialogueText": "OK!",
          "AudioPath": "assets/pl/Vincent/46.ogg",
          "TranslationKey": "Events/FarmHouse:3918603:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/FarmHouse/3918603:s2",
          "DialogueText": "Ja też!",
          "AudioPath": "assets/pl/Vincent/47.ogg",
          "TranslationKey": "Events/FarmHouse:3918603:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Town/6184643:s0",
          "DialogueText": "Czy to znaczy, że nie będzie pracy domowej? {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/48.ogg",
          "TranslationKey": "Events/Town:6184643:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Town/6184643:s1",
          "DialogueText": "Ostatnio dużo myślałam o torcie...",
          "AudioPath": "assets/pl/Vincent/49.ogg",
          "TranslationKey": "Events/Town:6184643:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Beach/733330:s0",
          "DialogueText": "Sam...? {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/50.ogg",
          "TranslationKey": "Events/Beach:733330:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Beach/733330:s1",
          "DialogueText": "Czy tata kiedyś wróci do domu? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/51.ogg",
          "TranslationKey": "Events/Beach:733330:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Beach/733330:s2",
          "DialogueText": "Ale słyszałem, niektórzy dorośli mówili... że wszystkie nasze wojska są rozstrzeliwane. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/52.ogg",
          "TranslationKey": "Events/Beach:733330:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Beach/733330:s3",
          "DialogueText": "Ok!",
          "AudioPath": "assets/pl/Vincent/53.ogg",
          "TranslationKey": "Events/Beach:733330:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/181928:s0",
          "DialogueText": "Panie {Farmer_Name}, ożeni się pan z panną Penny? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/54_male.ogg",
          "TranslationKey": "Events/Forest:181928:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Event/Forest/181928:s1",
          "DialogueText": "Panno {Farmer_Name}... em, ma pani chłopaka?",
          "AudioPath": "assets/pl/Vincent/55_female.ogg",
          "TranslationKey": "Events/Forest:181928:s1",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Event/Forest/choseFarming:s0",
          "DialogueText": "Em, {Farmer_Name}? Czy jeśli zjem Twoje warzywka, będę tak silny jak mój starszy brat Sam?",
          "AudioPath": "assets/pl/Vincent/56.ogg",
          "TranslationKey": "Events/Forest:choseFarming:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Event/Forest/choseFarming:s1",
          "DialogueText": "Jest silny, widziałem jak podniósł pannę Penny wczoraj wieczorem jak wspinali się na drzewo. {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/57.ogg",
          "TranslationKey": "Events/Forest:choseFarming:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/choseAnimals:s0",
          "DialogueText": "{Farmer_Name}? Mogę położyć siodło na jedną z twoich krów i przyjechać na niej do miasta? Jak prawdziwy kowboj!",
          "AudioPath": "assets/pl/Vincent/58.ogg",
          "TranslationKey": "Events/Forest:choseAnimals:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Event/Forest/choseMinerals:s0",
          "DialogueText": "{Farmer_Name}? To prawda, że gobliny mieszkają głęboko w jaskiniach... i że lubią porywać małe dziewczynki na obiad?",
          "AudioPath": "assets/pl/Vincent/59.ogg",
          "TranslationKey": "Events/Forest:choseMinerals:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Event/Forest/318560:s0",
          "DialogueText": "... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/60.ogg",
          "TranslationKey": "Events/Forest:318560:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/318560:s1",
          "DialogueText": "Czemu to jest zamknięte? Chcę iść na przygodę w ściekach! {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/61.ogg",
          "TranslationKey": "Events/Forest:318560:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/318560:s2",
          "DialogueText": "Profesor Gunther? Ten z muzeum? Czemu tak myślisz? {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/62.ogg",
          "TranslationKey": "Events/Forest:318560:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s0",
          "DialogueText": "Hejka, panie {Farmer_Name}!",
          "AudioPath": "assets/pl/Vincent/63_male.ogg",
          "TranslationKey": "Events/Forest:3910979:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s1",
          "DialogueText": "Hejka, panno {Farmer_Name}!",
          "AudioPath": "assets/pl/Vincent/64_female.ogg",
          "TranslationKey": "Events/Forest:3910979:s1",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra).",
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s2",
          "DialogueText": "Ceb... Cebula dymka. Mama mnie czasami wysyła po nią...",
          "AudioPath": "assets/pl/Vincent/65.ogg",
          "TranslationKey": "Events/Forest:3910979:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s3",
          "DialogueText": "Jak na dorosłego, jesteś spoko... więc wyjawię Ci tajemnicę. {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/66.ogg",
          "TranslationKey": "Events/Forest:3910979:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s4",
          "DialogueText": "Jak widzisz, dobrze wygląda, prawda?",
          "AudioPath": "assets/pl/Vincent/67.ogg",
          "TranslationKey": "Events/Forest:3910979:s4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s5",
          "DialogueText": "Ale jeśli trochę zedrzesz...",
          "AudioPath": "assets/pl/Vincent/68.ogg",
          "TranslationKey": "Events/Forest:3910979:s5",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s6",
          "DialogueText": "... Jest w tym dużo robaków! {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/69.ogg",
          "TranslationKey": "Events/Forest:3910979:s6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s7",
          "DialogueText": "Fajne, co? {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/70.ogg",
          "TranslationKey": "Events/Forest:3910979:s7",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Forest/3910979:s8",
          "DialogueText": "Zazwyczaj je zgniatam!",
          "AudioPath": "assets/pl/Vincent/71.ogg",
          "TranslationKey": "Events/Forest:3910979:s8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Vincent",
          "DialogueText": "Muuuu!",
          "AudioPath": "assets/pl/Vincent/72.ogg",
          "TranslationKey": "Data/Festivals/fall16:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Vincent_y2",
          "DialogueText": "Mogę jeszcze zagrać w namiocie z procą, Tato!? Proszę? {Portrait:Neutral}",
          "AudioPath": "assets/pl/Vincent/73.ogg",
          "TranslationKey": "Data/Festivals/fall16:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall27/Vincent",
          "DialogueText": "Mama nie pozwala mi iść do labiryntu. *szloch* {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/74.ogg",
          "TranslationKey": "Data/Festivals/fall27:Vincent",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Festival/fall27/Vincent_y2",
          "DialogueText": "Przeszliśmy labirynt? Gdzie moja nagroda? {Portrait:Neutral}",
          "AudioPath": "assets/pl/Vincent/75.ogg",
          "TranslationKey": "Data/Festivals/fall27:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring13/Vincent",
          "DialogueText": "Kiedy się zacznie? polowanie na jajka! Nie mogę się doczekać!! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/76.ogg",
          "TranslationKey": "Data/Festivals/spring13:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring13/Vincent_y2",
          "DialogueText": "Chcę mieszkać w dużym jajku!",
          "AudioPath": "assets/pl/Vincent/77.ogg",
          "TranslationKey": "Data/Festivals/spring13:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring24/Vincent",
          "DialogueText": "To nie fair... Dlaczego ja nie mogę być królową kwiatów?",
          "AudioPath": "assets/pl/Vincent/78.ogg",
          "TranslationKey": "Data/Festivals/spring24:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring24/Vincent_y2",
          "DialogueText": "Skoro jest królowa kwiatów... to musi też być król! {Portrait:Neutral}",
          "AudioPath": "assets/pl/Vincent/79.ogg",
          "TranslationKey": "Data/Festivals/spring24:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/summer11/Vincent",
          "DialogueText": "Nudzę się...",
          "AudioPath": "assets/pl/Vincent/80.ogg",
          "TranslationKey": "Data/Festivals/summer11:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/summer11/Vincent_y2",
          "DialogueText": "Czemu nie mogę się pobawić w tych małych stawikach? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/81.ogg",
          "TranslationKey": "Data/Festivals/summer11:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/summer28/Vincent",
          "DialogueText": "Chcę zobaczyć zieloną meduzę!",
          "AudioPath": "assets/pl/Vincent/82.ogg",
          "TranslationKey": "Data/Festivals/summer28:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/summer28/Vincent_y2",
          "DialogueText": "Raz dotknąłem meduzy i mnie poparzyła. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/83.ogg",
          "TranslationKey": "Data/Festivals/summer28:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter25/Vincent",
          "DialogueText": "Możemy już otworzyć prezenty?!",
          "AudioPath": "assets/pl/Vincent/84.ogg",
          "TranslationKey": "Data/Festivals/winter25:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter25/Vincent_y2",
          "DialogueText": "Dostałem zabawkowego dinozaura, którego chciałem! Widzisz!? {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/85.ogg",
          "TranslationKey": "Data/Festivals/winter25:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter25/Vincent_y2",
          "DialogueText": "To jest yy... Ste-... stego-... stegosonaur!... Tak myślę. {Portrait:Neutral}",
          "AudioPath": "assets/pl/Vincent/86.ogg",
          "TranslationKey": "Data/Festivals/winter25:Vincent_y2",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Festival/winter8/Vincent",
          "DialogueText": "Widziałem tam dużą rybę!",
          "AudioPath": "assets/pl/Vincent/87.ogg",
          "TranslationKey": "Data/Festivals/winter8:Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter8/Vincent_y2",
          "DialogueText": "Mój starszy brat pomaga mi ulepić bałwana! {Portrait:Neutral}",
          "AudioPath": "assets/pl/Vincent/88.ogg",
          "TranslationKey": "Data/Festivals/winter8:Vincent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Vincent:s0",
          "DialogueText": "Wow, bardzo Ci dziękuję! To jest wspaniałe!",
          "AudioPath": "assets/pl/Vincent/89.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Vincent:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Vincent:s1",
          "DialogueText": "To dla mnie? Wow, dzięki!",
          "AudioPath": "assets/pl/Vincent/90.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Vincent:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Vincent:s2",
          "DialogueText": "To nie jest śmieszne... {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/91.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Vincent:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Vincent:s3",
          "DialogueText": "Fuj, co to jest? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/92.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Vincent:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Vincent:s4",
          "DialogueText": "Dzięki!",
          "AudioPath": "assets/pl/Vincent/93.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Vincent:s4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_love_BeforeMovie",
          "DialogueText": "Nie mogę się doczekać! Mama powiedziała, że mogę wziąć coś słodkiego! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/94.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_love_BeforeMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_love_DuringMovie",
          "DialogueText": "Vincent świetnie się bawi!",
          "AudioPath": "assets/pl/Vincent/95.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_love_DuringMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_love_AfterMovie",
          "DialogueText": "Było super! Chcę to obejrzeć jeszcze raz! {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/96.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_love_AfterMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_dislike_BeforeMovie",
          "DialogueText": "A... Ale... Ten film jest dla dorosłych, prawda? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/97.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_dislike_BeforeMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_dislike_DuringMovie",
          "DialogueText": "Vincent wierci się na krześle.",
          "AudioPath": "assets/pl/Vincent/98.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_dislike_DuringMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Vincent_dislike_AfterMovie",
          "DialogueText": "To było nudne... Nic z tego nie zrozumiałem. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/99.ogg",
          "TranslationKey": "Strings/MovieReactions:Vincent_dislike_AfterMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:DesertFestival_Vincent",
          "DialogueText": "Mamo, nudzę się!",
          "AudioPath": "assets/pl/Vincent/100.ogg",
          "TranslationKey": "Strings/1_6_Strings:DesertFestival_Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:Shop_Vincent",
          "DialogueText": "Cześć! Eee... Znalazłem trochę rzeczy. Chcesz kupić!?",
          "AudioPath": "assets/pl/Vincent/101.ogg",
          "TranslationKey": "Strings/1_6_Strings:Shop_Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "winter_16.000",
          "DialogueText": "Chcę popływać łodzią!!",
          "AudioPath": "assets/pl/Vincent/102.ogg",
          "TranslationKey": "Strings/schedules/Vincent:winter_16.000",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "spring_11.001",
          "DialogueText": "*Przełknięcie*... Mamusiu, nie każ mi tego robić. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/103.ogg",
          "TranslationKey": "Strings/schedules/Vincent:spring_11.001",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "spring_11.002",
          "DialogueText": "Dostanę lizaka za to, że byłem dzielny?",
          "AudioPath": "assets/pl/Vincent/104.ogg",
          "TranslationKey": "Strings/schedules/Vincent:spring_11.002",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "spring_11.000",
          "DialogueText": "*chlip*... Muszę dostać zastrzyk. {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/105.ogg",
          "TranslationKey": "Strings/schedules/Vincent:spring_11.000",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Phone_Ring_Vincent",
          "DialogueText": "Halo?",
          "AudioPath": "assets/pl/Vincent/106.ogg",
          "TranslationKey": "Strings/Characters:Phone_Ring_Vincent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Phone_Ring_Vincent",
          "DialogueText": "Em... Uhhh... Tu Vincent. {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/107.ogg",
          "TranslationKey": "Strings/Characters:Phone_Ring_Vincent",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Phone_Ring_Vincent",
          "DialogueText": "Um... masz na swojej farmie jakieś świnki? {Portrait:Happy}",
          "AudioPath": "assets/pl/Vincent/108.ogg",
          "TranslationKey": "Strings/Characters:Phone_Ring_Vincent",
          "PageIndex": 3
        },
        {
          "DialogueFrom": "Phone_Ring_Vincent",
          "DialogueText": "Ok, muszę iść! *klik* {Portrait:Unique}",
          "AudioPath": "assets/pl/Vincent/109.ogg",
          "TranslationKey": "Strings/Characters:Phone_Ring_Vincent",
          "PageIndex": 5,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "NPC.cs.4293",
          "DialogueText": "Nie mogę w to uwierzyć, jesteś okrutną osobą! {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/110.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4293",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.4294",
          "DialogueText": "To boli! Co jest z Tobą nie tak? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/111.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4294",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Town_DumpsterDiveComment_Child",
          "DialogueText": "Fuu... Co ty robisz? {Portrait:Sad}",
          "AudioPath": "assets/pl/Vincent/112.ogg",
          "TranslationKey": "Data/ExtraDialogue:Town_DumpsterDiveComment_Child",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_Invited_Child",
          "DialogueText": "Film? Jej! Spotkajmy się na miejscu!",
          "AudioPath": "assets/pl/Vincent/113.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_Invited_Child",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_Reject_Child",
          "DialogueText": "Chyba nie mogę tego oglądać...",
          "AudioPath": "assets/pl/Vincent/114.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_Reject_Child",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_AlreadySeen",
          "DialogueText": "Wybacz, ten film był w tamtym tygodniu...",
          "AudioPath": "assets/pl/Vincent/115.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_AlreadySeen",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_InvitedBySomeoneElse",
          "DialogueText": "Wybacz. Idę do kina z kimś innym, może do nas dołączysz?",
          "AudioPath": "assets/pl/Vincent/116.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_InvitedBySomeoneElse",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.3956",
          "DialogueText": "Umm... nie wydaje mi się.",
          "AudioPath": "assets/pl/Vincent/117.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.3956",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.3957",
          "DialogueText": "Czy to żart? Nie łapię.",
          "AudioPath": "assets/pl/Vincent/118.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.3957",
          "PageIndex": 0
        }
      ]
    }
  ]
