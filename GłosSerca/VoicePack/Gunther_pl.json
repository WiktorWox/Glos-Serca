          "TranslationKey": "Events/Farm:66:s7",
          "PageIndex": 0,
          "DisplayPattern": "Och! Prawie zapomniałem!"
        },
        {
          "DialogueFrom": "Event/Farm/66:s8",
          "DialogueText": "Mam coś dla Ciebie... To stary klucz, był zamknięty w sejfie przez ponad 100 lat. Jest trochę zardzewiały, ale nadal piękny. {Portrait:Happy}",
          "AudioPath": "assets/pl/Gunther/9.ogg",
          "TranslationKey": "Events/Farm:66:s8",
          "PageIndex": 0,
          "DisplayPattern": "Mam coś dla Ciebie... To stary klucz, był zamknięty w sejfie przez ponad 100 lat. Jest trochę zardzewiały, ale nadal piękny."
        },
        {
          "DialogueFrom": "Event/Farm/66:s9",
          "DialogueText": "Otrzymujesz 'Zardzewiały Klucz'! Został dodany do Twojego portfela.",
          "AudioPath": "assets/pl/Gunther/10.ogg",
          "TranslationKey": "Events/Farm:66:s9",
          "PageIndex": 0,
          "DisplayPattern": "Otrzymujesz 'Zardzewiały Klucz'! Został dodany do Twojego portfela."
