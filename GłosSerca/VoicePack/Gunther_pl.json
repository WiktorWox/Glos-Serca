        {
          "DialogueFrom": "Event/Farm/66:s2",
          "DialogueText": "Mam nadzieję, że nie jest za wcześnie... {Portrait:Sad}",
          "AudioPath": "assets/pl/Gunther/3.ogg",
          "TranslationKey": "Events/Farm:66:s2",
          "PageIndex": 0,
          "DisplayPattern": "Mam nadzieję, że nie jest za wcześnie..."
        },
        {
          "DialogueFrom": "Event/Farm/66:s3",
          "DialogueText": "Chciałem wpaść i osobiście Ci podziękować za te wszystkie wspaniałe artefakty i minerały... tyle wspaniałych rzeczy! {Portrait:Happy}",
          "AudioPath": "assets/pl/Gunther/4.ogg",
          "TranslationKey": "Events/Farm:66:s3",
          "PageIndex": 0,
          "DisplayPattern": "Chciałem wpaść i osobiście Ci podziękować za te wszystkie wspaniałe artefakty i minerały... tyle wspaniałych rzeczy!"
        },
        {
          "DialogueFrom": "Event/Farm/66:s4",
          "DialogueText": "A nawet, dostałem list z biura regionalnego sekretariatu artefaktów... Otrzymaliśmy nagrodę 'złotej łopaty' za nasz znaczący wkład w tę dziedzinę!",
          "AudioPath": "assets/pl/Gunther/5.ogg",
          "TranslationKey": "Events/Farm:66:s4",
          "PageIndex": 0,
          "DisplayPattern": "A nawet, dostałem list z biura regionalnego sekretariatu artefaktów... Otrzymaliśmy nagrodę 'złotej łopaty' za nasz znaczący wkład w tę dziedzinę!"
        },
        {
          "DialogueFrom": "Event/Farm/66:s5",
          "DialogueText": "I wszystko dzięki Tobie! {Portrait:Happy}",
          "AudioPath": "assets/pl/Gunther/6.ogg",
          "TranslationKey": "Events/Farm:66:s5",
          "PageIndex": 0,
          "DisplayPattern": "I wszystko dzięki Tobie!"
        },
        {
          "DialogueFrom": "Event/Farm/66:s6",
          "DialogueText": "Cóż, nie będę Ci już przeszkadzał...",
          "AudioPath": "assets/pl/Gunther/7.ogg",
          "TranslationKey": "Events/Farm:66:s6",
          "PageIndex": 0,
          "DisplayPattern": "Cóż, nie będę Ci już przeszkadzał..."
        },
        {
          "DialogueFrom": "Event/Farm/66:s7",
          "DialogueText": "Och! Prawie zapomniałem!",
