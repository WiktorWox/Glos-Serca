        {
          "DialogueFrom": "ExtraDialogue/Gunther_MuseumComplete",
          "DialogueText": "Muzeum wygląda wspaniale! Jeszcze raz dziękuję za pomoc.",
          "AudioPath": "assets/pl/Gunther/25.ogg",
