{
  "Format": "2.0.0",
  "VoicePacks": [
    {
      "Format": "2.0.0",
      "VoicePackId": "GlosSerca.LeoMainland.pl",
      "VoicePackName": "Głos Serca (LeoMainland)",
      "Character": "LeoMainland",
      "Language": "pl",
      "Entries": [
        {
          "DialogueFrom": "4",
          "DialogueText": "Widziałem wielkie mango lecące po niebie. Linus powiedział, że to balon! {Portrait:Unique}",
          "AudioPath": "assets/pl/LeoMainland/1.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "4",
          "DialogueText": "Myślałem, że tylko ptaki potrafią latać...",
          "AudioPath": "assets/pl/LeoMainland/2.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:4",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "18",
          "DialogueText": "Gdy pierwszy raz się tu zjawiłem, Linus zrobił mi ubranie z liści, takie jak to...",
          "AudioPath": "assets/pl/LeoMainland/3.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:18",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "18",
          "DialogueText": "Ale wyglądałem śmiesznie... jak puszyste mango! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/4.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:18",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "18",
          "DialogueText": "Myślę, że jednak wolę pozostać przy piórach.",
          "AudioPath": "assets/pl/LeoMainland/5.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:18",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "LeoDeparture",
          "DialogueText": "Muszę znaleźć jakieś miejsce do zamieszkania... {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/6.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:LeoDeparture",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "LeoDeparture",
          "DialogueText": "Ale mam plan... będę polegał na moich przyjaciołach.",
          "AudioPath": "assets/pl/LeoMainland/7.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:LeoDeparture",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "AcceptGift_(O)StardropTea",
          "DialogueText": "Wow, smakuje dokładnie jak złote orzechy! To niesamowite!",
          "AudioPath": "assets/pl/LeoMainland/8.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:AcceptGift_(O)StardropTea",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain",
          "DialogueText": "Podoba mi się ta pogoda... jest taka wilgotna. Przypomina mi las na wyspie.",
          "AudioPath": "assets/pl/LeoMainland/9.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:GreenRain",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu8",
          "DialogueText": "Na początku źle się czułem z tym, że musiałem opuścić wyspę. {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/10.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu8",
          "DialogueText": "Ale z czasem się do tego przyzwyczaiłem.",
          "AudioPath": "assets/pl/LeoMainland/11.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu8",
          "DialogueText": "Jestem bardzo elastyczny! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/12.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu8",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Thu10",
          "DialogueText": "Na początku czułem się tutaj obco. Ale teraz mam wielu przyjaciół! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/13.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu10",
          "DialogueText": "Po raz pierwszy czuję, że naprawdę gdzieś przynależę...",
          "AudioPath": "assets/pl/LeoMainland/14.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu10",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Panna Penny robi wszystko, co może, żeby pomóc mi się uczyć. Jest bardzo miła...",
          "AudioPath": "assets/pl/LeoMainland/15.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Tue",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "... Na szczęście pamiętam trochę rzeczy z dawnego, bardzo dawnego życia... zanim trafiłem na wyspę... więc nie jest tak trudno.",
          "AudioPath": "assets/pl/LeoMainland/16.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Tue",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Panna Penny mówi, że jest zaskoczona tym, ile już wiem!",
          "AudioPath": "assets/pl/LeoMainland/17.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Tue",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Tue10",
          "DialogueText": "Myślę, że Jas i Vincent na początku uważali mnie za dziwaka. Kilka razy zapiszczałem na lekcjach... to nie pomogło. {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/18.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Tue10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue10",
          "DialogueText": "To była duża zmiana dla wszystkich. Ale teraz jesteśmy dobrymi przyjaciółmi! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/19.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Tue10",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Nauczę się wszystkiego, co tylko możliwe, od Linusa i panny Penny! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/20.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Wed",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Burmistrz Lewis mówi, że jestem na dobrej drodze, żeby zostać 'prawowitym obywatelem'... cokolwiek to znaczy.",
          "AudioPath": "assets/pl/LeoMainland/21.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Wed",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Zauważyłeś wszystkie interesujące ptaki, które tu mieszkają?",
          "AudioPath": "assets/pl/LeoMainland/22_male.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Zauważyłaś wszystkie interesujące ptaki, które tu mieszkają?",
          "AudioPath": "assets/pl/LeoMainland/23_female.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Jeśli się dobrze wsłuchasz, mogą Ci coś powiedzieć.",
          "AudioPath": "assets/pl/LeoMainland/24.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Thu",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "winter_Thu",
          "DialogueText": "Ptakom z doliny zimno niespecjalnie przeszkadza.",
          "AudioPath": "assets/pl/LeoMainland/25.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:winter_Thu",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "winter_Thu",
          "DialogueText": "Trochę zazdroszczę ich ciepłych piórek... {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/26.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:winter_Thu",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Linus uczy mnie wszystkiego o dzikich przysmakach doliny. Jest tu tyle dobrych rzeczy! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/27.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Fri",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Ale... trochę tęsknię za złotymi orzechami na śniadanie każdego dnia... {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/28.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Fri",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "winter_Fri",
          "DialogueText": "Linus nauczył mnie, jak przygotować specjalną rybę nacieraną ostrymi jagodami...",
          "AudioPath": "assets/pl/LeoMainland/29.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:winter_Fri",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "winter_Fri",
          "DialogueText": "Mówi, że jeśli będę jadł jej wystarczająco dużo, zimą nie będzie mi zimno! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/30.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:winter_Fri",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Fri8",
          "DialogueText": "Wujek Linus mówi, że najpierw powinienem 'ugotować' rybę, zanim ją zjem... {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/31.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Fri8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri8",
          "DialogueText": "Trudno mi się do tego przyzwyczaić... taka wysuszona... {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/32.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Fri8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Hej, {Farmer_Name}. Miło Cię znowu zobaczyć, jak za dawnych czasów. Było super!",
          "AudioPath": "assets/pl/LeoMainland/33.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Mon",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Wiesz, gdy pierwszy raz Cię zobaczyłem, byłem przestraszony... wiedziałem, że moje życie się zmieni. {Portrait:Unique}",
          "AudioPath": "assets/pl/LeoMainland/34.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Mon",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Dolina Stardew może być moim domem... ale wyspa zawsze będzie moim prawdziwym domem.",
          "AudioPath": "assets/pl/LeoMainland/35.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sun",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Dobrze czasem tam wrócić, choć na chwilę.",
          "AudioPath": "assets/pl/LeoMainland/36.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sun",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Może kiedyś odwiedzę Miasto Zuzu... {Portrait:Unique}",
          "AudioPath": "assets/pl/LeoMainland/37.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Ale jeszcze nie jestem na to gotowy. Ten świat wciąż wydaje mi się obcy i dobrze mi tu, gdzie jestem! {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/38.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sun10",
          "DialogueText": "Papugi chciały, żebym Ci podziękował za wszystkie złote orzechy, które od Ciebie dostały. Bardzo im smakowały. {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/39.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sun10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat10",
          "DialogueText": "{Farmer_Name}? Em... Trochę się wstydzę zapytać... {Portrait:Unique}",
          "AudioPath": "assets/pl/LeoMainland/40.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat10",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Sat10",
          "DialogueText": "Ale... myślisz, że Jas mogłaby kiedyś polubić kogoś takiego jak ja? {Portrait:Unique}",
          "AudioPath": "assets/pl/LeoMainland/41.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat10",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sat10",
          "DialogueText": "A może jestem zbyt dziwny? {Portrait:Sad}",
          "AudioPath": "assets/pl/LeoMainland/42.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat10",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Sat10",
          "DialogueText": "Ha ha ha... nieważne. Kiedyś się przekonam. {Portrait:Happy}",
          "AudioPath": "assets/pl/LeoMainland/43.ogg",
          "TranslationKey": "Characters/Dialogue/LeoMainland:Sat10",
          "PageIndex": 3
        }
      ]
    }
  ]
}
