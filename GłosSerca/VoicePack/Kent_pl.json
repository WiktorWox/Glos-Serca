{
  "Format": "2.0.0",
  "VoicePacks": [
    {
      "Format": "2.0.0",
      "VoicePackId": "GlosSerca.Kent.pl",
      "VoicePackName": "Głos Serca (Kent)",
      "Character": "Kent",
      "Language": "pl",
      "Entries": [
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Witaj, farmerze.",
          "AudioPath": "assets/pl/Kent/1_male.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Mon",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Witaj, farmerko.",
          "AudioPath": "assets/pl/Kent/2_female.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Mon",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Mon",
          "DialogueText": "Tak długo mnie tu nie było... Czuję się tu trochę obco.",
          "AudioPath": "assets/pl/Kent/3.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Mon",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "AcceptGift_(O)StardropTea",
          "DialogueText": "To dla mnie? Cóż, nie spodziewałem się tego... ale nie odmówię. Dzięki!",
          "AudioPath": "assets/pl/Kent/4.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:AcceptGift_(O)StardropTea",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "AcceptGift_(O)Book_Bombs",
          "DialogueText": "Cóż, nie znam krasnoludzkiego, ale to ciekawy przedmiot kolekcjonerski. Dziękuję.",
          "AudioPath": "assets/pl/Kent/5.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:AcceptGift_(O)Book_Bombs",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain_2",
          "DialogueText": "Heh... Deszcz to błogosławieństwo. Przypomnienie, że zawsze istnieją siły większe niż wszystko, co stworzył człowiek.",
          "AudioPath": "assets/pl/Kent/6.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:GreenRain_2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "GreenRain_2",
          "DialogueText": "Jest to poniekąd pocieszające, {Farmer_Name}.",
          "AudioPath": "assets/pl/Kent/7.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:GreenRain_2",
          "PageIndex": 1,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Resort_Entering",
          "DialogueText": "Hej, {Farmer_Name}. Dobrze Cię widzieć.",
          "AudioPath": "assets/pl/Kent/8.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Entering",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Resort_Leaving",
          "DialogueText": "Pora wracać.",
          "AudioPath": "assets/pl/Kent/9.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Leaving",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort_Shore",
          "DialogueText": "Stojąc na tej plaży... czuję rzadkie poczucie spokoju. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/10.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Shore",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort_Shore",
          "DialogueText": "Ocean jest naprawdę wyjątkowy.",
          "AudioPath": "assets/pl/Kent/11.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Shore",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Resort_Chair",
          "DialogueText": "To dobre miejsce do budowania więzi z rodziną. Naprawdę doceniam, że to naprawiłeś.",
          "AudioPath": "assets/pl/Kent/12_male.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Chair",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Resort_Chair",
          "DialogueText": "To dobre miejsce do budowania więzi z rodziną. Naprawdę doceniam, że to naprawiłaś.",
          "AudioPath": "assets/pl/Kent/13_female.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Chair",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Resort_Bar",
          "DialogueText": "Wezmę wodę.",
          "AudioPath": "assets/pl/Kent/14.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort_Bar",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "married_Sam",
          "DialogueText": "Ojciec czuje dumę, widząc, jak jego syn staje się mężczyzną. Masz moje serdeczne błogosławieństwo. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/15.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:married_Sam",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Resort",
          "DialogueText": "Fajnie się tutaj płynęło. Mogłem nawet wykorzystać część mojego szkolenia żeglarskiego do nawigacji. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/16.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Resort",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "eventSeen_100_memory_oneday",
          "DialogueText": "Przepraszam za wczoraj.",
          "AudioPath": "assets/pl/Kent/17.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:eventSeen_100_memory_oneday",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "eventSeen_100_memory_oneday",
          "DialogueText": "Nie chcę żadnego specjalnego traktowania. Chcę po prostu być normalną osobą, jak każdy inny.",
          "AudioPath": "assets/pl/Kent/18.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:eventSeen_100_memory_oneday",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "MovieInvitation",
          "DialogueText": "Em... ok. Dziękuję. Spotkamy się na miejscu. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/19.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:MovieInvitation",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "...! {Portrait:Love}",
          "AudioPath": "assets/pl/Kent/20.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "... Skąd to masz? {Portrait:Love}",
          "AudioPath": "assets/pl/Kent/21.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "... {Portrait:Angry}",
          "AudioPath": "assets/pl/Kent/22.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "On... walczyliśmy razem na wojnie, {Farmer_Name}. Był dla mnie jak brat.",
          "AudioPath": "assets/pl/Kent/23.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 3,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "Ale... tylko jeden z nas wrócił. {Portrait:Angry}",
          "AudioPath": "assets/pl/Kent/24.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 4
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "Do końca zachował zimną krew. Nawet w obliczu śmierci. Prawdziwy bohater... nigdy mu tego nie zapomnę.",
          "AudioPath": "assets/pl/Kent/25.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 5
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "Dziękuję Ci za to... to dla mnie naprawdę wiele znaczy.",
          "AudioPath": "assets/pl/Kent/26.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 6
        },
        {
          "DialogueFrom": "accept_864",
          "DialogueText": "Proszę, weź to. Stało za naszą szafą przez lata i tylko się kurzyło.",
          "AudioPath": "assets/pl/Kent/27.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:accept_864",
          "PageIndex": 7
        },
        {
          "DialogueFrom": "reject_865",
          "DialogueText": "Tak... Jest szczelnie zapakowane, żeby zachowało smak.",
          "AudioPath": "assets/pl/Kent/28.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:reject_865",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Mon4",
          "DialogueText": "Nie wiem, czy kiedykolwiek znów przyzwyczaję się do takiego życia.",
          "AudioPath": "assets/pl/Kent/29.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Mon4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Mon4",
          "DialogueText": "Ten spokój jest dla mnie trochę dziwny... ale może to kwestia czasu.",
          "AudioPath": "assets/pl/Kent/30.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Mon4",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Odkąd wyjechałem, wiele się nie zmieniło.",
          "AudioPath": "assets/pl/Kent/31.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Tue",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue",
          "DialogueText": "Pomijając to, że ty tu jesteś.",
          "AudioPath": "assets/pl/Kent/32.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Tue",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue2",
          "DialogueText": "Odkąd wyjechałem, wiele się nie zmieniło.",
          "AudioPath": "assets/pl/Kent/33.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Tue2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Tue2",
          "DialogueText": "Poza tym, że mamy nowego farmera. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/34.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Tue2",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Tue6",
          "DialogueText": "Czuję, że całkiem nieźle się zaaklimatyzowałem. Miło mieć przyjaciela w mieście. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/35.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Tue6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed6",
          "DialogueText": "... Na wojnie straciłem wielu przyjaciół. {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/36.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Wed6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed6",
          "DialogueText": "Najgorsze jest to, że nie pamiętam już ich twarzy.",
          "AudioPath": "assets/pl/Kent/37.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Wed6",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Wed6",
          "DialogueText": "...",
          "AudioPath": "assets/pl/Kent/38.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Wed6",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Wed",
          "DialogueText": "Mieszkasz tu już od jakiegoś czasu, prawda? Twoja farma musi dobrze prosperować.",
          "AudioPath": "assets/pl/Kent/39.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Wed",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Wed10",
          "DialogueText": "Życie to wyjątkowy dar. Przychodzi i odchodzi w mgnieniu oka... Nigdy o tym nie zapominaj.",
          "AudioPath": "assets/pl/Kent/40.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Wed10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu6",
          "DialogueText": "# {Portrait:Happy} Kent1",
          "AudioPath": "assets/pl/Kent/41.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu6",
          "DialogueText": "Od czwartej rano jestem na nogach... czasami zastanawiam się, czy kiedykolwiek wrócę do normalnego trybu życia.$k",
          "AudioPath": "assets/pl/Kent/42.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu6",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu6",
          "DialogueText": "Sam naprawdę sporo urósł. Jest już mężczyzną.",
          "AudioPath": "assets/pl/Kent/43.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu6",
          "PageIndex": 2
        },
        {
          "DialogueFrom": "Thu6",
          "DialogueText": "Szkoda, że nie mogłem być przy nim przez te wszystkie lata. {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/44.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu6",
          "PageIndex": 3
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Przyjaźnisz się z moim synem?",
          "AudioPath": "assets/pl/Kent/45.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Thu",
          "DialogueText": "Prawdopodobnie znasz go lepiej niż ja... {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/46.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Thu_inlaw_Sam",
          "DialogueText": "Witaj, {Farmer_Name}. Jak tam po ślubie?",
          "AudioPath": "assets/pl/Kent/47.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Thu_inlaw_Sam",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Fri",
          "DialogueText": "Całkiem niezły dzień, żeby wybrać się na ryby, co nie?",
          "AudioPath": "assets/pl/Kent/48.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Fri",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Fri4",
          "DialogueText": "Powinienem zacząć chodzić na ryby. To by mi dobrze zrobiło.",
          "AudioPath": "assets/pl/Kent/49.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Fri4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Jodi mówiła, że stałeś się częścią tej społeczności. Miło mi to słyszeć.",
          "AudioPath": "assets/pl/Kent/50_male.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sat",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Sat",
          "DialogueText": "Jodi mówiła, że stałaś się częścią tej społeczności. Miło mi to słyszeć.",
          "AudioPath": "assets/pl/Kent/51_female.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sat",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "Sat8",
          "DialogueText": "Mam problemy ze snem, więc nie przejmuj się, jeśli wyglądam na zmęczonego.",
          "AudioPath": "assets/pl/Kent/52.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sat8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sat8",
          "DialogueText": "Mam nadzieję, że to rozumiesz.",
          "AudioPath": "assets/pl/Kent/53.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sat8",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Nie wiem, co ze sobą zrobić.",
          "AudioPath": "assets/pl/Kent/54.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sun",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sun",
          "DialogueText": "Jestem przyzwyczajony do planowania każdego dnia.",
          "AudioPath": "assets/pl/Kent/55.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sun",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Sun4",
          "DialogueText": "Masz jakieś zajęcie, co? To bardzo dobrze.",
          "AudioPath": "assets/pl/Kent/56.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sun4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Sun4",
          "DialogueText": "Za dużo wolności może przytłaczać. Wszyscy potrzebujemy jakiejś struktury w życiu.",
          "AudioPath": "assets/pl/Kent/57.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:Sun4",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "event_popcorn1",
          "DialogueText": "Cicho bądź! Przestań próbować mnie skłócić z żoną. {Portrait:Unique}",
          "AudioPath": "assets/pl/Kent/58.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:event_popcorn1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "event_popcorn2",
          "DialogueText": "... {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/59.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:event_popcorn2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "event_popcorn2",
          "DialogueText": "Masz rację, {Farmer_Name}. {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/60.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:event_popcorn2",
          "PageIndex": 1,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "event_popcorn3",
          "DialogueText": "Nie kłam! Nie znoszę kłamstw bardziej niż czegokolwiek innego! {Portrait:Unique}",
          "AudioPath": "assets/pl/Kent/61.ogg",
          "TranslationKey": "Characters/Dialogue/Kent:event_popcorn3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Farm/63:s0",
          "DialogueText": "Em... witaj. Jestem Kent. Wróciłem ostatniej nocy... z zagranicy. Żona mi powiedziała, że wprowadził się nowy farmer.",
          "AudioPath": "assets/pl/Kent/62.ogg",
          "TranslationKey": "Events/Farm:63:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Farm/63:s1",
          "DialogueText": "Cóż, chciałem się tylko przedstawić... Do zobaczenia.",
          "AudioPath": "assets/pl/Kent/63.ogg",
          "TranslationKey": "Events/Farm:63:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/95:s0",
          "DialogueText": "Cześć {Farmer_Name}. Proszę, zapraszam.",
          "AudioPath": "assets/pl/Kent/64.ogg",
          "TranslationKey": "Events/SamHouse:95:s0",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Event/SamHouse/95:s1",
          "DialogueText": "He he. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/65.ogg",
          "TranslationKey": "Events/SamHouse:95:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/95:s2",
          "DialogueText": "Mmm... Ten chrupiący Bass był przepyszny! Panierka była wspaniała...",
          "AudioPath": "assets/pl/Kent/66.ogg",
          "TranslationKey": "Events/SamHouse:95:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/95:s3",
          "DialogueText": "Czuję się prawie jak członek rodziny.",
          "AudioPath": "assets/pl/Kent/67.ogg",
          "TranslationKey": "Events/SamHouse:95:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s0",
          "DialogueText": "AAAAAHHHHHHH!!! {Portrait:Unique}",
          "AudioPath": "assets/pl/Kent/68.ogg",
          "TranslationKey": "Events/SamHouse:100:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s1",
          "DialogueText": "Ten dźwięk... {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/69.ogg",
          "TranslationKey": "Events/SamHouse:100:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s2",
          "DialogueText": "Ten dźwięk przypomina mi o wojnie! {Portrait:Unique}",
          "AudioPath": "assets/pl/Kent/70.ogg",
          "TranslationKey": "Events/SamHouse:100:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s3",
          "DialogueText": "... Straciłem wielu przyjaciół w tych krwawych okopach. {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/71.ogg",
          "TranslationKey": "Events/SamHouse:100:s3",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s4",
          "DialogueText": "... Trochę się pozmieniało.",
          "AudioPath": "assets/pl/Kent/72.ogg",
          "TranslationKey": "Events/SamHouse:100:s4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s5",
          "DialogueText": "(Powiedz mu coś) {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/73.ogg",
          "TranslationKey": "Events/SamHouse:100:s5",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s6",
          "DialogueText": "Powinniśmy winić Jodi... Mogła się domyślić!",
          "AudioPath": "assets/pl/Kent/74.ogg",
          "TranslationKey": "Events/SamHouse:100:s6",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s7",
          "DialogueText": "Wiem, że cierpisz... ale nie wiń swojej żony.",
          "AudioPath": "assets/pl/Kent/75.ogg",
          "TranslationKey": "Events/SamHouse:100:s7",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s8",
          "DialogueText": "(Kłamstwo) To moja wina... Zachciało mi się popcornu",
          "AudioPath": "assets/pl/Kent/76.ogg",
          "TranslationKey": "Events/SamHouse:100:s8",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s9",
          "DialogueText": "... {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/77.ogg",
          "TranslationKey": "Events/SamHouse:100:s9",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/SamHouse/100:s10",
          "DialogueText": "Wybacz, Kochanie. Nie wiedziałaś, że odgłosy popcornu mogą mnie denerwować.",
          "AudioPath": "assets/pl/Kent/78.ogg",
          "TranslationKey": "Events/SamHouse:100:s10",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Event/Saloon/3917590:s0",
          "DialogueText": "Cieszę się, że mam pretekst żeby wyjść z domu i oderwać myśli od różnych rzeczy.",
          "AudioPath": "assets/pl/Kent/79.ogg",
          "TranslationKey": "Events/Saloon:3917590:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Kent",
          "DialogueText": "Czekam aż ten klaun zrobi coś śmiesznego.",
          "AudioPath": "assets/pl/Kent/80.ogg",
          "TranslationKey": "Data/Festivals/fall16:Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/fall16/Kent",
          "DialogueText": "Rozczarowujące.",
          "AudioPath": "assets/pl/Kent/81.ogg",
          "TranslationKey": "Data/Festivals/fall16:Kent",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Festival/fall16/Kent_y2",
          "DialogueText": "*heh* Mój syn ma cela. Ciekawe czy ma to po mnie. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/82.ogg",
          "TranslationKey": "Data/Festivals/fall16:Kent_y2",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Festival/fall27/Kent",
          "DialogueText": "Hej, {Farmer_Name}. Dobry wieczór?",
          "AudioPath": "assets/pl/Kent/83.ogg",
          "TranslationKey": "Data/Festivals/fall27:Kent",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Festival/fall27/Kent_y2",
          "DialogueText": "Nie wyglądają na takie twarde. {Portrait:Neutral}",
          "AudioPath": "assets/pl/Kent/84.ogg",
          "TranslationKey": "Data/Festivals/fall27:Kent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring13/Kent",
          "DialogueText": "Tak szczerze, to nie lubię jajek.",
          "AudioPath": "assets/pl/Kent/85.ogg",
          "TranslationKey": "Data/Festivals/spring13:Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring24/Kent",
          "DialogueText": "Ta otwarta przestrzeń... Denerwuję się przez nią.",
          "AudioPath": "assets/pl/Kent/86.ogg",
          "TranslationKey": "Data/Festivals/spring24:Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring24/Kent",
          "DialogueText": "*szept* Myśl pozytywnie, Kent. Myśl pozytywnie.",
          "AudioPath": "assets/pl/Kent/87.ogg",
          "TranslationKey": "Data/Festivals/spring24:Kent",
          "PageIndex": 1,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Festival/spring24/Kent_y2",
          "DialogueText": "Zastanawiasz się czasami... czemu uważamy, że kwiatki są takie piękne?",
          "AudioPath": "assets/pl/Kent/88.ogg",
          "TranslationKey": "Data/Festivals/spring24:Kent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/spring24/Kent_y2",
          "DialogueText": "Jeśli z Jodi będziemy mieć kiedyś córkę, może nazwiemy ją po jakimś kwiatku. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/89.ogg",
          "TranslationKey": "Data/Festivals/spring24:Kent_y2",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Festival/summer11/Kent",
          "DialogueText": "Hej, dobrze Cię widzieć.",
          "AudioPath": "assets/pl/Kent/90.ogg",
          "TranslationKey": "Data/Festivals/summer11:Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/summer11/Kent_y2",
          "DialogueText": "*niuch*... Zapachy najlepiej przywołują wspomnienia... {Portrait:Neutral}",
          "AudioPath": "assets/pl/Kent/91.ogg",
          "TranslationKey": "Data/Festivals/summer11:Kent_y2",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "Festival/summer11/Kent_y2",
          "DialogueText": "To może być dobre i złe...",
          "AudioPath": "assets/pl/Kent/92.ogg",
          "TranslationKey": "Data/Festivals/summer11:Kent_y2",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "Festival/summer28/Kent",
          "DialogueText": "Dobry wieczór, {Farmer_Name}. Mam nadzieję, że znajdziesz chwilę na odpoczynek przed zbiorami.",
          "AudioPath": "assets/pl/Kent/93.ogg",
          "TranslationKey": "Data/Festivals/summer28:Kent",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Festival/summer28/Kent_y2",
          "DialogueText": "Hej. Masz wielkie plany na jesień?",
          "AudioPath": "assets/pl/Kent/94.ogg",
          "TranslationKey": "Data/Festivals/summer28:Kent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter25/Kent",
          "DialogueText": "Dobry wieczór, {Farmer_Name}. Miłego ucztowania.",
          "AudioPath": "assets/pl/Kent/95.ogg",
          "TranslationKey": "Data/Festivals/winter25:Kent",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Festival/winter25/Kent_y2",
          "DialogueText": "Jestem wdzięczny za to, że widzę jakie moje dziecko jest zdrowe i szczęśliwe. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/96.ogg",
          "TranslationKey": "Data/Festivals/winter25:Kent_y2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter8/Kent",
          "DialogueText": "Lubię zimę. Jest spokojna.",
          "AudioPath": "assets/pl/Kent/97.ogg",
          "TranslationKey": "Data/Festivals/winter8:Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Festival/winter8/Kent_y2",
          "DialogueText": "Gotowy na zawody? Wszyscy myślimy, że wygrasz.",
          "AudioPath": "assets/pl/Kent/98_male.ogg",
          "TranslationKey": "Data/Festivals/winter8:Kent_y2",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "Festival/winter8/Kent_y2",
          "DialogueText": "Gotowa na zawody? Wszyscy myślimy, że wygrasz.",
          "AudioPath": "assets/pl/Kent/99_female.ogg",
          "TranslationKey": "Data/Festivals/winter8:Kent_y2",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "NPCGiftTastes/Kent:s0",
          "DialogueText": "O...! Mama zawsze mi to dawała, gdy byłem jeszcze dzieckiem. Cudowne wspomnienia... dziękuję.",
          "AudioPath": "assets/pl/Kent/100.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Kent:s0",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Kent:s1",
          "DialogueText": "Hej, to dobry prezent. Dzięki.",
          "AudioPath": "assets/pl/Kent/101.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Kent:s1",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Kent:s2",
          "DialogueText": "Ach... To... Co to właściwie jest? Hmm...",
          "AudioPath": "assets/pl/Kent/102.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Kent:s2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPCGiftTastes/Kent:s3",
          "DialogueText": "To... Dawali mi to w obozie jeńców w Gotoro. Chciałem o tym zapomnieć. *dreszcze*",
          "AudioPath": "assets/pl/Kent/103.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Kent:s3",
          "PageIndex": 0,
          "ActorNote": "*…* – opis odgłosu albo czynności, nie słowo do przeczytania."
        },
        {
          "DialogueFrom": "NPCGiftTastes/Kent:s4",
          "DialogueText": "To miłe z Twojej strony. Na pewno to się spodoba mojej rodzinie.",
          "AudioPath": "assets/pl/Kent/104.ogg",
          "TranslationKey": "Data/NPCGiftTastes:Kent:s4",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_like_BeforeMovie",
          "DialogueText": "Dzięki za zaproszenie, {Farmer_Name}. Ciężko mi wrócić do życia cywila, ale dzięki Tobie, czuję się jak w domu.",
          "AudioPath": "assets/pl/Kent/105.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_like_BeforeMovie",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "MovieReactions/Kent_like_DuringMovie",
          "DialogueText": "To jest świetne... Przypomina mi o prostych czasach... {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/106.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_like_DuringMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_like_DuringMovie_2",
          "DialogueText": "Kent ma rzadki uśmiech na twarzy.",
          "AudioPath": "assets/pl/Kent/107.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_like_DuringMovie_2",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_like_AfterMovie",
          "DialogueText": "Było fajnie. Kiedy jesteś pochłonięty filmem, wszystkie twoje troski i zmartwienia znikają.",
          "AudioPath": "assets/pl/Kent/108.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_like_AfterMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_dislike_BeforeMovie",
          "DialogueText": "Nie jestem pewien co do tego filmu...",
          "AudioPath": "assets/pl/Kent/109.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_dislike_BeforeMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_dislike_DuringMovie",
          "DialogueText": "Kenta przelewa zimny pot...",
          "AudioPath": "assets/pl/Kent/110.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_dislike_DuringMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieReactions/Kent_dislike_AfterMovie",
          "DialogueText": "To było dla mnie niezłym wyzwaniem. I tak doceniam twoje zaproszenie.",
          "AudioPath": "assets/pl/Kent/111.ogg",
          "TranslationKey": "Strings/MovieReactions:Kent_dislike_AfterMovie",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:DesertFestival_Kent",
          "DialogueText": "Hej, {Farmer_Name}. Doskwiera Ci ten upał?",
          "AudioPath": "assets/pl/Kent/112.ogg",
          "TranslationKey": "Strings/1_6_Strings:DesertFestival_Kent",
          "PageIndex": 0,
          "ActorNote": "{Farmer_Name} – imię gracza (wstawia gra)."
        },
        {
          "DialogueFrom": "Strings/1_6_Strings:Shop_Kent",
          "DialogueText": "Hej, mam parę rzeczy na sprzedaż. Daj znać, jak coś Ci wpadnie w oko.",
          "AudioPath": "assets/pl/Kent/113.ogg",
          "TranslationKey": "Strings/1_6_Strings:Shop_Kent",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Quest_119",
          "DialogueText": "Hej. Cśś... Jodi nie może go zobaczyć.",
          "AudioPath": "assets/pl/Kent/114.ogg",
          "TranslationKey": "Data/Quests:119",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Quest_119",
          "DialogueText": "Ach, wygląda soczyście. Spodoba jej się. Bardzo Ci dziękuję. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/115.ogg",
          "TranslationKey": "Data/Quests:119",
          "PageIndex": 1
        },
        {
          "DialogueFrom": "NPC.cs.4293",
          "DialogueText": "Nie mogę w to uwierzyć, jesteś okrutną osobą! {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/116.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4293",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.4294",
          "DialogueText": "To boli! Co jest z Tobą nie tak? {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/117.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4294",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "Town_DumpsterDiveComment_Adult",
          "DialogueText": "Hej, przestań! Fuj! {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/118.ogg",
          "TranslationKey": "Data/ExtraDialogue:Town_DumpsterDiveComment_Adult",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.4275",
          "DialogueText": "Urodzinowy prezent? To miłe z Twojej strony! Uwielbiam to. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/119.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4275",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.4277",
          "DialogueText": "Pamiętałeś o moich urodzinach! Dziękuję. To jest wspaniały prezent. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/120_male.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4277",
          "PageIndex": 0,
          "GenderVariant": "male"
        },
        {
          "DialogueFrom": "NPC.cs.4277",
          "DialogueText": "Pamiętałaś o moich urodzinach! Dziękuję. To jest wspaniały prezent. {Portrait:Happy}",
          "AudioPath": "assets/pl/Kent/121_female.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4277",
          "PageIndex": 1,
          "GenderVariant": "female"
        },
        {
          "DialogueFrom": "NPC.cs.4279",
          "DialogueText": "Och... to na moje urodziny?... Dzięki. {Portrait:Sad}",
          "AudioPath": "assets/pl/Kent/122.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4279",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.4281",
          "DialogueText": "Och, urodzinowy prezent! Dziękuję.",
          "AudioPath": "assets/pl/Kent/123.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.4281",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_Reject",
          "DialogueText": "Wybacz, nie mam ochoty iść na film...",
          "AudioPath": "assets/pl/Kent/124.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_Reject",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_AlreadySeen",
          "DialogueText": "Wybacz, ten film był w tamtym tygodniu...",
          "AudioPath": "assets/pl/Kent/125.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_AlreadySeen",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "MovieInvite_InvitedBySomeoneElse",
          "DialogueText": "Wybacz. Idę do kina z kimś innym, może do nas dołączysz?",
          "AudioPath": "assets/pl/Kent/126.ogg",
          "TranslationKey": "Strings/Characters:MovieInvite_InvitedBySomeoneElse",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.3956",
          "DialogueText": "Umm... nie wydaje mi się.",
          "AudioPath": "assets/pl/Kent/127.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.3956",
          "PageIndex": 0
        },
        {
          "DialogueFrom": "NPC.cs.3957",
          "DialogueText": "Czy to żart? Nie łapię.",
          "AudioPath": "assets/pl/Kent/128.ogg",
          "TranslationKey": "Strings/StringsFromCSFiles:NPC.cs.3957",
          "PageIndex": 0
        }
      ]
    }
  ]
